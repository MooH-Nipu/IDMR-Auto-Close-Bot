# Safe default. Replace with this server's LAN IP for access from another PC.
BIND_IP=127.0.0.1
PORT=5000
HOST_UID=1000
HOST_GID=1000

# Preferred: set your internal CA path (container path for Docker).
IDMR_CA_BUNDLE=
# Fallback for trusted internal self-signed IDMR only. Disables upstream TLS verification.
IDMR_TLS_INSECURE=false
